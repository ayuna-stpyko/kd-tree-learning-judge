# systemd のユーザサービス。start.sh が @REPO@ を置き換えて ~/.config/systemd/user/ に置く。
[Unit]
Description=kd-tree judge (API, workers, leaderboard)
After=network-online.target

[Service]
WorkingDirectory=@REPO@
ExecStart=/usr/bin/python3 -m judge
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
